<?xml version="1.0" encoding="UTF-8"?>
<!-- hive-site 由 infra-ops 注入；{{__master_ip}}/{{nn_rpc_port}} 运行时渲染 -->
<configuration>
  <!-- HiveServer2/Metastore 需访问的 HDFS 入口（组合部署中由引擎注入：HA=nameservice，非 HA=nn:port） -->
  <property>
    <name>fs.defaultFS</name>
    <value>{{__hdfs_entry}}</value>
  </property>
  <!-- HiveServer2 经 thrift 连接元数据服务（{{__ha_hive_ms}}：非 HA 单 uri，HA 双 uri） -->
  <property>
    <name>hive.metastore.uris</name>
    <value>{{__ha_hive_ms}}</value>
  </property>
{{__ha_hive_jdo}}  <property>
    <name>hive.metastore.warehouse.dir</name>
    <value>/apps/hive/warehouse</value>
  </property>
{{__ha_hive_zk}}  <property>
    <name>hive.server2.thrift.bind.host</name>
    <value>0.0.0.0</value>
  </property>
  <property>
    <name>hive.server2.thrift.port</name>
    <value>10000</value>
  </property>
  <property>
    <name>hive.server2.webui.port</name>
    <value>10002</value>
  </property>
  <property>
    <name>hive.server2.webui.host</name>
    <value>0.0.0.0</value>
  </property>
  <!-- 平台化部署默认以 hive 用户执行，避免多用户映射问题 -->
  <property>
    <name>hive.server2.enable.doAs</name>
    <value>false</value>
  </property>
  <!-- 关闭内置 scheduled query 执行器：其初始化强依赖主机名解析（getLocalHost），容器化场景易卡启动 -->
  <property>
    <name>hive.scheduled.queries.execution.enabled</name>
    <value>false</value>
  </property>
  <!-- Hive 4.0 默认仅 metastore 管理员可调用 notification API；HS2 以 hive 用户连接会被拒，
       导致 NotificationEventPoll 初始化失败、HS2 循环重试永不监听 10000 -->
  <property>
    <name>metastore.metastore.event.db.notification.api.auth</name>
    <value>false</value>
  </property>
</configuration>
